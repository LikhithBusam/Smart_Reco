# Copy to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string

# --- Database (Postgres, via docker-compose service name "db") ---
DATABASE_URL=postgresql+asyncpg://smartreco:smartreco@db:5432/smartreco

# --- Redis (via docker-compose service name "redis") ---
REDIS_URL=redis://redis:6379/0

# --- Vector DB (Chroma persistent local storage) ---
CHROMA_PERSIST_DIR=/data/chroma

# --- Auth ---
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# --- Mesh API (mandatory for all LLM/embedding calls) ---
MESH_API_KEY=rsk_your_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_CHAT_MODEL=openai/gpt-4o
MESH_EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Agent trigger/cache tuning (ARCHITECTURE.md §5/§6) ---
TRIGGER_EVENT_THRESHOLD=5
RECOMMENDATION_TTL_HOURS=6
OUTBOX_POLL_INTERVAL_SECONDS=5

# --- Observability (bonus) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=smartreco

# --- Proactive delivery (bonus) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_SEND_HOUR_UTC=14
